# LuminaLab Swarm — Operating Environment Configurations

# -------------------------------------------------------------------
# Option 1A: Bedrock Mantle Bearer Token (OpenAI-compatible)
# -------------------------------------------------------------------
LUMINA_MOCK_MODE=false
DEEPSEEK_API_KEY=your-bedrock-or-deepseek-api-key-here
DEEPSEEK_PRO_MODEL=deepseek.v3.2
OPENAI_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-s3-vault-bucket
POLLY_VOICE_AR=Hala
POLLY_VOICE_EN=Joanna
DYNAMO_TABLE_NAME=your-dynamodb-impact-table
# -------------------------------------------------------------------
# Option 1B: Native DeepSeek Platform Key (from platform.deepseek.com)
# -------------------------------------------------------------------
# LUMINA_MOCK_MODE=false
# DEEPSEEK_API_KEY=your-deepseek-api-key-here
# DEEPSEEK_PRO_MODEL=deepseek-chat
# OPENAI_BASE_URL=https://api.deepseek.com

# -------------------------------------------------------------------
# Option 2: Default 100% Offline Local Deterministic Mock Mode
# Zero internet, zero external API keys, 100% sandboxed
# -------------------------------------------------------------------
# LUMINA_MOCK_MODE=true

# -------------------------------------------------------------------
# Option 3: Full AWS IAM Account Mode (SigV4 signing via boto3)
# -------------------------------------------------------------------
# LUMINA_MOCK_MODE=false
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
